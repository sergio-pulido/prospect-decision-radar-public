# Copy to .env.local and fill in. A missing key makes that provider run on fixtures.
# Jev via OpenRouter (default route). https://openrouter.ai/docs/guides/community/jev
JEV_API_KEY_OPENROUTER=
# Optional: defaults https://openrouter.ai/api/v1/systemone and typesafe/jev-1.14
JEV_BASE_URL=
JEV_MODEL=
# TypeSafe direct (only used when JEV_USE_TYPESAFE_DIRECT=1). TYPESAFE_API_KEY is also accepted.
JEV_USE_TYPESAFE_DIRECT=
JEV_API_KEY=
# Linkup (https://app.linkup.so)
LINKUP_API_KEY=
# standard | deep | fast
LINKUP_DEPTH=standard
# Cala (https://docs.cala.ai)
CALA_API_KEY=
# Apollo organization enrichment (optional; org data only, organizations/enrich). Empty = off.
APOLLO_API_KEY=
# Mapbox public token (pk.*) for the hero map; empty = SVG radar fallback. Never an sk token.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Session call caps (defaults: Jev 400, Linkup 200, Cala 60). Ledger: runs/call-ledger.json
CAP_JEV=
CAP_LINKUP=
CAP_CALA=
CAP_APOLLO=
CAP_GEOCODE=
# Set to 1 to force every provider onto fixtures (demo safety net).
FORCE_FIXTURES=
